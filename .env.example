NODE_ENV=development
HOST=127.0.0.1
PORT=5000
WEB_ORIGIN=http://localhost:8080
MONGODB_URI=mongodb://127.0.0.1:27017/researchpilot
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_TIMEOUT_MS=10000
# Match these public client IDs in the frontend .env. Popup token exchange uses
# POST /api/v1/auth/google and /api/v1/auth/microsoft; no backend callback URL.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_TENANT_ID=common
